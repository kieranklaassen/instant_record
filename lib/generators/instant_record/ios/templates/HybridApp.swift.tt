import InstantRecordNative
import SwiftUI

/// <%= app_name %> on iPhone. Its tabs and pages come from Rails
/// (config/native.yml), so a deploy changes them.<% if compiled? %> A tab or a route that
/// names a Ruby screen is drawn by it, from the phone's own database.<% end %>
///
/// Launch arguments:
///   -server <%= options[:server] %>   the Rails app
<% if compiled? -%>
///   -dev YES                          ask Rails for each Ruby screen: no rebuild after an edit
<% end -%>
@main
struct <%= app_name %>App: App {
    @StateObject private var host: HybridHost

    init() {
        // Views written in SwiftUI, by the name Ruby or config/native.yml
        // gives them, are registered here.
        var views = Screens()
        register(&views)

        let defaults = UserDefaults.standard
        let address = defaults.string(forKey: "server") ?? "<%= options[:server] %>"
        guard let server = URL(string: address), server.host != nil else { fatalError("Not a server's address: \(address)") }
        // What Ruby, pages and views may ask of the device. Those that ask the
        // person are added by group: capabilities.allow(.location). Say why in
        // Info.plist.
        let capabilities = Capabilities()
<% if compiled? -%>
        let folder = URL.applicationSupportDirectory
        try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
        let engine: Engine = defaults.bool(forKey: "dev") ? HTTPEngine(server: address + "<%= mount_path %>") : LibraryEngine()
        let app = AppHost(engine: engine, root: Route("<%= options[:screen] %>"), views: views, store: { _ in
            AppHost.Store(database: folder.appending(path: "app.sqlite3").path, endpoint: address + "<%= mount_path %>")
        })
        app.start()
        _host = StateObject(wrappedValue: HybridHost(server: server, app: app, screens: rubyScreens, capabilities: capabilities))
<% else -%>
        _host = StateObject(wrappedValue: HybridHost(server: server, views: views, capabilities: capabilities))
<% end -%>
    }

    var body: some Scene {
        WindowGroup { HybridView(host: host) }
    }
}

private func register(_ views: inout Screens) {
    // views.register("Name") { props, actions in NameView(props: props) }
}
