<%# Shared initial-load root for both Rails and the compiled runtime:
    InstantRecord::Inertia::Page builds `@page`, ERB escapes it into `data-page`,
    and the gem's frontend package hands it to Inertia (frontend/index.js).
    The page itself is app/frontend/pages/Email/Inbox.jsx in both runtimes. %>
<% content_for(:title, "Inbox · Shared inbox") %>
<div id="app" data-page="<%= @page %>"></div>
<script type="module" src="<%= asset_path("inbox.js") %>"></script>
