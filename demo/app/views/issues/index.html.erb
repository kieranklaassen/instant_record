<div class="container">
  <header>
    <h1>InstantRecord Issues</h1>
    <p class="meta">
      Runtime: <strong><%= InstantRecord.browser? ? "browser (ruby.wasm + PGlite)" : "server (CRuby + Postgres)" %></strong>
      <% if InstantRecord.browser? %>
        · Pending mutations: <strong id="pending-count"><%= @pending_count %></strong>
      <% end %>
    </p>
  </header>

  <%= form_with url: issues_path, method: :post, data: { turbo: false } do |f| %>
    <%= f.text_field "issue[title]", placeholder: "New issue title", required: true, autofocus: true %>
    <%= f.submit "Create" %>
  <% end %>

  <ul class="issues">
    <% @issues.each do |issue| %>
      <li class="<%= issue.state %>">
        <%= button_to issue.state == "done" ? "Reopen" : "Done", issue_path(issue), method: :patch, form: { data: { turbo: false } } %>
        <span class="title"><%= issue.title %></span>
        <span class="badge badge-<%= issue.sync_state %>"><%= issue.sync_state %></span>
        <%= button_to "×", issue_path(issue), method: :delete, form: { data: { turbo: false } } %>
      </li>
    <% end %>
  </ul>
</div>

<style>
  body { font-family: -apple-system, sans-serif; max-width: 640px; margin: 2rem auto; padding: 0 1rem; }
  header h1 { margin-bottom: 0.25rem; }
  .meta { color: #666; margin-top: 0; }
  form { display: flex; gap: 0.5rem; margin: 1rem 0; }
  form input[type="text"] { flex: 1; padding: 0.5rem; }
  ul.issues { list-style: none; padding: 0; }
  ul.issues li { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0; border-bottom: 1px solid #eee; }
  ul.issues li.done .title { text-decoration: line-through; color: #999; }
  .title { flex: 1; }
  .badge { font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 4px; background: #e5e5e5; }
  .badge-pending { background: #fff3cd; }
  .badge-synced { background: #d4edda; }
  .badge-rejected { background: #f8d7da; }
</style>

<script>
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.addEventListener("message", (event) => {
      if (event.data && event.data.type === "records_changed") {
        window.location.reload();
      }
    });
  }
</script>
