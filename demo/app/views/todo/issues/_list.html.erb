<% open_issues = @issues.count { |i| i.state != "done" } %>
<% done_issues = @issues.size - open_issues %>
<% pending_text = "#{@pending_count} #{"mutation".pluralize(@pending_count)}" %>
<ul class="issues"
    data-issues-target="list"
    data-open="<%= open_issues %>"
    data-done="<%= done_issues %>"
    data-pending="<%= pending_text %>">
  <% @issues.each do |issue| %>
    <% issue_href = todo_issue_path(issue) %>
    <li class="<%= issue.state %>" data-id="<%= issue.id %>">
      <%# The checkbox is the control: ticking it submits the form it sits
          in; the issues controller catches the submit and morphs instead
          of navigating. The title is its label, so the whole row is the
          hit area. %>
      <%= form_with url: issue_href, method: :patch, class: "toggle", data: { turbo: false, action: "submit->issues#submit" } do %>
        <%= check_box_tag "done", "1", issue.state == "done",
                          id: "issue-#{issue.id}-done",
                          onchange: "this.form.requestSubmit()" %>
        <%= label_tag "issue-#{issue.id}-done", issue.title, class: "title" %>
      <% end %>
      <% if issue.sync_state == "pending" %>
        <span class="badge badge-pending">Waiting to sync</span>
      <% end %>
      <%= button_to "×", issue_href, method: :delete, "aria-label": "Delete issue", form: { data: { turbo: false, action: "submit->issues#submit" } } %>
    </li>
  <% end %>
</ul>
