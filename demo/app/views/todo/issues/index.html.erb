<% content_for(:title, "Todo — InstantRecord") %>

<% open_issues = @issues.count { |i| i.state != "done" } %>
<% done_issues = @issues.size - open_issues %>

<%# data-instant-refresh + the issues controller: writes go over fetch and the
    list morphs by data-id — add, update, remove — so scroll position and the
    composer's focus survive every change. Same records-changed signal and
    morph discipline as the chat page; removal is allowed here because this
    list is complete, not a window. %>
<div class="todo-page"
     data-instant-refresh
     data-controller="issues"
     data-action="instant-record:records-changed@window->issues#sync">
  <section class="todo-main">
    <h1>Todo</h1>
    <p class="todo-lede">The list this browser owns. Every change commits here first, then syncs.</p>

    <div class="card todo-card">
      <%= form_with url: todo_issues_path, method: :post, class: "todo-form", data: { turbo: false, action: "submit->issues#submit" } do |f| %>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        <%= f.text_field "issue[title]", placeholder: "Add an issue and press Enter", "aria-label": "New issue title", required: true, autofocus: true %>
        <%= f.submit "Add" %>
      <% end %>

      <%= render "list" %>
    </div>
  </section>

  <aside class="todo-facts">
    <div class="todo-stats">
      <div class="todo-stat card">
        <p>Open</p>
        <p class="todo-stat-num" data-issues-target="open"><%= open_issues %></p>
      </div>
      <div class="todo-stat card">
        <p>Done</p>
        <p class="todo-stat-num" data-issues-target="done"><%= done_issues %></p>
      </div>
    </div>
    <dl class="todo-runtime">
      <div><dt>Runtime</dt><dd><%= InstantRecord.browser? ? "Spinel (WebAssembly)" : "CRuby" %></dd></div>
      <div><dt>Store</dt><dd><%= InstantRecord.browser? ? "SQLite" : "Postgres" %></dd></div>
      <% if InstantRecord.browser? %>
        <div><dt>Waiting to sync</dt><dd id="pending-count" data-issues-target="pending"><%= @pending_count %> <%= "mutation".pluralize(@pending_count) %></dd></div>
      <% end %>
    </dl>
    <p class="todo-hint">Try the title “reject me”. The browser saves it, then the server’s rule rejects it and the row rolls back.</p>
  </aside>
</div>
