<% content_for(:title, "Todo — InstantRecord") %>

<div class="page">
  <header class="page-header">
    <p class="micro-label">Demo 01</p>
    <h1>Todo</h1>
    <p class="meta">
      Runtime: <strong><%= InstantRecord.browser? ? "browser (ruby.wasm + PGlite)" : "server (CRuby + Postgres)" %></strong>
      <% if InstantRecord.browser? %>
        · Pending mutations: <strong id="pending-count"><%= @pending_count %></strong>
      <% end %>
    </p>
  </header>

  <%= form_with url: todo_issues_path, method: :post, class: "todo-form", data: { turbo: false } do |f| %>
    <%= f.text_field "issue[title]", placeholder: "New issue title", required: true, autofocus: true %>
    <%= f.submit "Create" %>
  <% end %>

  <ul class="issues">
    <% @issues.each do |issue| %>
      <li class="<%= issue.state %>">
        <%# The checkbox is the control: ticking it submits the form it sits in,
            so a plain reload of the page is the whole interaction — served
            locally in the browser runtime. %>
        <%= form_with url: todo_issue_path(issue), method: :patch, class: "toggle", data: { turbo: false } do %>
          <%= check_box_tag "done", "1", issue.state == "done",
                            id: "issue-#{issue.id}-done",
                            onchange: "this.form.requestSubmit()" %>
          <%= label_tag "issue-#{issue.id}-done", issue.title, class: "title" %>
        <% end %>
        <%= button_to "×", todo_issue_path(issue), method: :delete, form: { data: { turbo: false } } %>
      </li>
    <% end %>
  </ul>
</div>
