<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "InstantRecord Demos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="InstantRecord Demos">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Asset-pipeline icons: public/ isn't packed into the wasm bundle, so
        hardcoded /icon.png 404s on every page load in the browser runtime. %>
    <link rel="icon" href="<%= asset_path("icon.png") %>" type="image/png">
    <link rel="icon" href="<%= asset_path("icon.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path("icon.png") %>">

    <%# Brand type, with full system fallbacks: offline or blocked, the page
        still renders in the platform's own sans and serif. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=JetBrains+Mono:wght@400;500&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# After the import map: a page module tag emitted before it (via
        content_for :head) would fetch against the default resolver and fail
        to resolve its bare specifier. %>
    <%= yield :head %>
  </head>

  <body class="demo-<%= controller_path.split("/").first %>"
        data-controller="inspector">
    <% demo = controller_path.split("/").first %>
    <header class="site-bar">
      <a class="wordmark" href="<%= root_path %>">
        <span class="wordmark-mark" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7Z"/></svg></span>
        <span class="wordmark-text">InstantRecord</span>
      </a>
      <%# Spelled out rather than looped: the compiled runtime builds this
          template ahead of time, and plain markup is the safest input. %>
      <nav class="site-tabs" aria-label="Demos">
        <a href="<%= root_path %>" aria-current="<%= demo == "home" ? "page" : "false" %>">Home</a>
        <a href="<%= todo_root_path %>" aria-current="<%= demo == "todo" ? "page" : "false" %>">Todo</a>
        <a href="<%= slack_root_path %>" aria-current="<%= demo == "slack" ? "page" : "false" %>">Chat</a>
        <a href="/email" data-turbo="false" aria-current="<%= demo == "email" ? "page" : "false" %>">Inbox</a>
        <a href="/assistant" aria-current="<%= demo == "assistant" ? "page" : "false" %>">Assistant</a>
        <a href="<%= migrate_root_path %>" aria-current="<%= demo == "migrate" ? "page" : "false" %>">Ship v2</a>
        <a href="<%= console_root_path %>" aria-current="<%= demo == "console" ? "page" : "false" %>">Console</a>
      </nav>
      <%# Mirrors the inspector's own Offline checkbox; inspector#toggleOffline
          keeps the two in step, so either one drives the same simulation. %>
      <label class="net-switch">
        <input type="checkbox" role="switch" aria-label="Offline mode"
               data-inspector-target="headerOffline"
               data-action="inspector#toggleOffline">
        <span class="net-dot" aria-hidden="true"></span><span class="net-label" aria-hidden="true"></span>
        <span class="net-track" aria-hidden="true"></span>
      </label>
      <a class="site-source" href="#source-drawer" data-turbo="false" data-open-source>View source</a>
    </header>

    <%= yield %>

    <%# Proof rather than prose: the controller, view and models behind this page,
        read out of the packed wasm bundle by the runtime that just rendered it.
        Collapsed and lazy — source_controller.js fetches /source the first time
        the drawer is opened. Nothing is pasted, so nothing can go stale. %>
    <details id="source-drawer"
             data-controller="source"
             data-source-url-value="<%= source_path(page: controller_path, view: action_name) %>"
             data-action="toggle->source#load click@document->source#reveal">
      <summary>
        <span class="micro-label">The code behind this page</span>
        <span class="meta">Read live out of app.wasm — not a snippet</span>
      </summary>
      <div class="source-body" data-source-target="body"></div>
    </details>

    <%# Shared by every demo: what the sync loop is doing, and switches to make
        it misbehave on purpose. Both switches affect only the sync server — the
        local runtime keeps serving pages, which is the point. %>
    <aside id="inspector">
      <header>
        <span class="micro-label">Sync inspector</span>
      </header>

      <div class="inspector-controls">
        <label>
          <input type="checkbox" data-inspector-target="offline"
                 data-action="inspector#simulate">
          Offline
        </label>
        <label>
          <input type="checkbox" data-inspector-target="slow"
                 data-action="inspector#simulate">
          Slow (2s)
        </label>
        <button type="button" data-action="inspector#clear">Clear</button>
      </div>

      <%# The map. Each flow lights up as the log below records traffic on it, so
          the moving parts and the direction of travel are visible rather than
          inferred from a list of paths. %>
      <svg id="inspector-flow" viewBox="0 0 320 272" role="img"
           aria-label="Sync architecture: your page and Compiled Rails in this browser, syncing to Rails and Postgres on the server">
        <defs>
          <marker id="flow-arrow" viewBox="0 0 8 8" refX="4" refY="4"
                  markerWidth="4" markerHeight="4" orient="auto-start-reverse">
            <path d="M 0 0 L 8 4 L 0 8 z" />
          </marker>
        </defs>

        <g class="flow-zone">
          <rect x="8" y="16" width="304" height="112" />
          <text class="flow-zone-label" x="12" y="11">This browser · dedicated worker</text>
        </g>

        <g class="flow-node" data-flow="page">
          <rect x="24" y="26" width="272" height="26" />
          <text x="160" y="43">Your page — views, Turbo</text>
        </g>

        <g class="flow-node" data-flow="wasm">
          <rect x="24" y="64" width="272" height="26" />
          <text x="160" y="81">Compiled Rails</text>
        </g>

        <g class="flow-node" data-flow="sqlite">
          <rect x="24" y="102" width="272" height="20" />
          <text x="160" y="116">SQLite in this tab</text>
        </g>

        <g class="flow-zone">
          <rect x="8" y="186" width="304" height="78" />
          <text class="flow-zone-label" x="12" y="181">Your server</text>
        </g>

        <g class="flow-node" data-flow="server">
          <rect x="24" y="196" width="272" height="26" />
          <text x="160" y="213">Rails + Falcon</text>
        </g>

        <g class="flow-node" data-flow="postgres">
          <rect x="24" y="232" width="272" height="22" />
          <text x="160" y="247">Postgres — the source of truth</text>
        </g>

        <%# Instant: the network is nowhere on this path, which is the point. %>
        <path class="flow-edge" data-flow="local" d="M 160 52 L 160 64" />
        <text class="flow-edge-label" x="168" y="61">in-process · no network</text>
        <path class="flow-edge" data-flow="db" d="M 160 90 L 160 102" />
        <text class="flow-edge-label" x="168" y="99">SQL</text>

        <%# The only two wires crossing the gap. Arrowheads carry the direction
            when nothing is moving; the dashes march when something is. %>
        <path class="flow-edge" data-flow="up"
              d="M 96 128 L 96 196" marker-end="url(#flow-arrow)" />
        <path class="flow-edge" data-flow="down"
              d="M 224 196 L 224 128" marker-end="url(#flow-arrow)" />

        <%# Each label sits outside its own wire; crowded into the middle they
            collide with each other. %>
        <text class="flow-edge-label" x="88" y="144" text-anchor="end">writes up<tspan x="88" dy="9">HTTP POST</tspan><tspan x="88" dy="9">/mutations</tspan></text>
        <text class="flow-edge-label" x="232" y="144">changes down<tspan x="232" dy="9">polled every second</tspan><tspan x="232" dy="9">/events</tspan></text>
      </svg>

      <ol class="inspector-log" data-inspector-target="log"></ol>
    </aside>

  </body>
</html>
