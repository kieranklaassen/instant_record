<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "InstantRecord Demos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="InstantRecord Demos">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Asset-pipeline icons: public/ isn't packed into the wasm bundle, so
        hardcoded /icon.png 404s on every page load in the browser runtime. %>
    <link rel="icon" href="<%= asset_path("icon.png") %>" type="image/png">
    <link rel="icon" href="<%= asset_path("icon.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path("icon.png") %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# After the import map: a page module tag emitted before it (via
        content_for :head) would fetch against the default resolver and fail
        to resolve its bare specifier. %>
    <%= yield :head %>
  </head>

  <body class="demo-<%= controller_path.split("/").first %>"
        data-controller="inspector">
    <nav class="site-nav">
      <%= link_to "InstantRecord", root_path, class: "wordmark" %>
      <span class="micro-label">Local-first Rails demos</span>
    </nav>

    <%= yield %>

    <%# Shared by every demo: what the sync loop is doing, and switches to make
        it misbehave on purpose. Both switches affect only the sync server — the
        local runtime keeps serving pages, which is the point. %>
    <aside id="inspector">
      <header>
        <span class="micro-label">Sync inspector</span>
      </header>

      <div class="inspector-controls">
        <label>
          <input type="checkbox" data-inspector-target="offline"
                 data-action="inspector#simulate">
          Offline
        </label>
        <label>
          <input type="checkbox" data-inspector-target="slow"
                 data-action="inspector#simulate">
          Slow (2s)
        </label>
        <button type="button" data-action="inspector#clear">Clear</button>
      </div>

      <%# The map. Each flow lights up as the log below records traffic on it, so
          the moving parts and the direction of travel are visible rather than
          inferred from a list of paths. %>
      <svg id="inspector-flow" viewBox="0 0 320 272" role="img"
           aria-label="Sync architecture: your page and Rails on ruby.wasm in this browser, syncing to Rails and Postgres on the server">
        <defs>
          <marker id="flow-arrow" viewBox="0 0 8 8" refX="4" refY="4"
                  markerWidth="4" markerHeight="4" orient="auto-start-reverse">
            <path d="M 0 0 L 8 4 L 0 8 z" />
          </marker>
        </defs>

        <g class="flow-zone">
          <rect x="8" y="16" width="304" height="112" />
          <text class="flow-zone-label" x="12" y="11">This browser · service worker</text>
        </g>

        <g class="flow-node" data-flow="page">
          <rect x="24" y="26" width="272" height="26" />
          <text x="160" y="43">Your page — views, Turbo</text>
        </g>

        <g class="flow-node" data-flow="wasm">
          <rect x="24" y="64" width="272" height="26" />
          <text x="160" y="81">Rails on ruby.wasm</text>
        </g>

        <g class="flow-node" data-flow="pglite">
          <rect x="24" y="102" width="272" height="20" />
          <text x="160" y="116">PGlite — Postgres in this tab</text>
        </g>

        <g class="flow-zone">
          <rect x="8" y="186" width="304" height="78" />
          <text class="flow-zone-label" x="12" y="181">Your server</text>
        </g>

        <g class="flow-node" data-flow="server">
          <rect x="24" y="196" width="272" height="26" />
          <text x="160" y="213">Rails + Falcon</text>
        </g>

        <g class="flow-node" data-flow="postgres">
          <rect x="24" y="232" width="272" height="22" />
          <text x="160" y="247">Postgres — the source of truth</text>
        </g>

        <%# Instant: the network is nowhere on this path, which is the point. %>
        <path class="flow-edge" data-flow="local" d="M 160 52 L 160 64" />
        <text class="flow-edge-label" x="168" y="61">in-process · no network</text>
        <path class="flow-edge" data-flow="db" d="M 160 90 L 160 102" />
        <text class="flow-edge-label" x="168" y="99">SQL</text>

        <%# The only two wires crossing the gap. Arrowheads carry the direction
            when nothing is moving; the dashes march when something is. %>
        <path class="flow-edge flow-edge-long" data-flow="up"
              d="M 96 128 L 96 196" marker-end="url(#flow-arrow)" />
        <path class="flow-edge flow-edge-long" data-flow="down"
              d="M 224 196 L 224 128" marker-end="url(#flow-arrow)" />

        <%# Each label sits outside its own wire; crowded into the middle they
            collide with each other. %>
        <text class="flow-edge-label" x="88" y="144" text-anchor="end">writes up<tspan x="88" dy="9">HTTP POST</tspan><tspan x="88" dy="9">/mutations</tspan></text>
        <text class="flow-edge-label" x="232" y="144">changes down<tspan x="232" dy="9">SSE, held open</tspan><tspan x="232" dy="9">/events</tspan></text>
      </svg>

      <ol class="inspector-log" data-inspector-target="log"></ol>
    </aside>

    <div id="new-version" hidden>
      <span class="micro-label">A new build is ready</span>
      <button type="button" onclick="window.location.reload()">Reload</button>
    </div>

    <script>
      // Two things arrive from the service worker.
      //
      // sw_updated: a new bundle took over. Ask rather than reload — an
      // unannounced reload throws away whatever is in a composer. Nothing
      // else is at risk: unsynced writes live in the outbox in PGlite, so
      // they survive a reload whenever it happens.
      //
      // records_changed: a sync pass applied changes. Pages with a
      // data-instant-refresh root fold them in without re-rendering (see
      // controllers/conversation_controller.js); the rest reload.
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.addEventListener("message", (event) => {
          const type = event.data && event.data.type;
          if (type === "sw_updated") {
            document.getElementById("new-version")?.removeAttribute("hidden");
          } else if (type === "records_changed") {
            if (document.querySelector("[data-instant-refresh]")) {
              window.dispatchEvent(new CustomEvent("instant-record:records-changed"));
            } else {
              window.location.reload();
            }
          }
        });
      }
    </script>
  </body>
</html>
