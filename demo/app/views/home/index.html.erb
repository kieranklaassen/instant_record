<% content_for(:title, "InstantRecord Demos") %>

<div class="home-board">
  <div class="board-hero">
    <div class="hero-copy">
      <p class="micro-label kicker">Four demos</p>
      <h1>Rails models<br>that run in<br>the browser.</h1>
      <p class="lede">
        Compiled to WebAssembly, rendered in a service worker, backed by
        Postgres in the tab. Writes commit locally, queue in a durable outbox,
        and sync when you're online. Everyone else's changes stream back down
        over server-sent events.
      </p>
    </div>
    <aside class="hero-facts">
      <div>
        <p class="micro-label">Demos</p>
        <p class="stat-huge">04</p>
      </div>
      <div class="facts">
        <p>Runtime<br><strong><%= InstantRecord.browser? ? "ruby.wasm" : "CRuby" %></strong></p>
        <p>Store<br><strong><%= InstantRecord.browser? ? "PGlite" : "Postgres" %></strong></p>
        <p>Sync<br><strong>Outbox + SSE</strong></p>
      </div>
      <p class="micro-label foot">Go offline; keep working</p>
    </aside>
  </div>

  <ul class="demo-grid">
    <li>
      <%= link_to todo_root_path, class: "demo-card" do %>
        <p class="card-no">01</p>
        <h2>Todo</h2>
        <p class="card-copy">Optimistic local writes, and a server-only validation that rejects a
        title after the browser already accepted it.</p>
        <span class="go">Open ⟶</span>
      <% end %>
    </li>
    <li>
      <%= link_to slack_root_path, class: "demo-card" do %>
        <p class="card-no">02</p>
        <h2>Chat</h2>
        <p class="card-copy">Channels, DMs, threads, and users who reply from the server —
        messages arrive over SSE without touching a WebSocket.</p>
        <span class="go">Open ⟶</span>
      <% end %>
    </li>
    <li>
      <%= link_to migrate_root_path, class: "demo-card" do %>
        <p class="card-no">03</p>
        <h2>Ship v2</h2>
        <p class="card-copy">Fill a local database, leave writes unsynced, then run a migration
        over the top. Your rows and your queue both have to survive.</p>
        <span class="go">Open ⟶</span>
      <% end %>
    </li>
    <li>
      <%= link_to console_root_path, class: "demo-card" do %>
        <p class="card-no">04</p>
        <h2>Console</h2>
        <p class="card-copy">No UI, no seeds, nothing staged — an ActiveRecord prompt against the
        database in this tab. Type a query the demo didn't anticipate.</p>
        <span class="go">Open ⟶</span>
      <% end %>
    </li>
  </ul>

  <div class="board-band">
    <span>Rendered by Rails inside your browser — runtime:
      <strong><%= InstantRecord.browser? ? "browser (ruby.wasm + PGlite)" : "server (CRuby + Postgres)" %></strong></span>
    <%= link_to "What this cost on your device ⟶", receipts_path %>
  </div>

  <footer class="project-strip">
    <p class="micro-label">Open source</p>
    <p>
      InstantRecord is an MIT-licensed Ruby gem. These demos are its test bed —
      every page here is in the repo, and the source drawer below reads it out
      of the running bundle.
    </p>
    <p class="project-links">
      <a href="https://github.com/kieranklaassen/instant_record">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        GitHub
      </a>
      <a href="https://rubygems.org/gems/instant_record">RubyGems</a>
      <code>gem "instant_record"</code>
    </p>
  </footer>
</div>
