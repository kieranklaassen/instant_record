<aside class="sidebar">
  <header class="sidebar-header">
    <span class="brand-mark" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.1-4.6A8 8 0 1 1 21 12Z"/></svg></span>
    <div>
      <p class="brand">Chat</p>
      <p class="micro-label">InstantRecord demo</p>
    </div>
  </header>

  <div class="sidebar-scroll">
    <section>
      <h3 class="micro-label">Channels</h3>
      <ul>
        <% @channels.each do |channel| %>
          <li class="<%= "active" if channel == @channel %>">
            <%= link_to slack_channel_path(channel) do %>
              <span class="hash" aria-hidden="true">#</span><span class="name"><%= channel.name %></span><span class="count"><%= @channel_counts&.fetch(channel.id, 0).to_i %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <section>
      <h3 class="micro-label">Direct messages</h3>
      <ul>
        <% @dms.each do |dm| %>
          <% dm_user = @users_by_id ? @users_by_id[dm.dm_user_id] : dm.dm_user %>
          <li class="<%= "active" if dm == @channel %>">
            <%= link_to slack_channel_path(dm) do %>
              <span class="dm-tile <%= slack_tile_class(dm_user) %>" aria-hidden="true"><%= slack_initials(dm_user) %></span><span class="name"><%= dm_user&.name || dm.name %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <section>
      <h3 class="micro-label">Users</h3>
      <ul class="roster">
        <% @users.each do |user| %>
          <li>
            <span class="dot"></span><%= user.name %><%= " (you)" if user.visitor? %>
          </li>
        <% end %>
      </ul>
    </section>
  </div>

  <footer class="sidebar-footer">
    <% if InstantRecord.browser? %>
      <p class="outbox-row"><span>Outbox</span><span class="count"><%= @pending_count.to_i %></span></p>
    <% end %>
    <%# Posted by the reset controller, which then reloads — a reset is the one
        thing that deletes records, and live updates never remove rows. %>
    <form class="reset-form" action="<%= slack_reset_endpoint %>" method="post"
          data-controller="reset" data-action="reset#submit">
      <button type="submit">Reset demo</button>
    </form>
  </footer>
</aside>
