<% content_for(:title, "Chat — InstantRecord") %>

<%# data-instant-refresh: the layout's records_changed listener hands this
    page a custom event instead of reloading — the conversation controller
    morphs the DOM in place. Channel switches and thread opens swap only the
    affected pane via lightweight fragments, keeping the sidebar and Stimulus
    controller alive. The open thread stays URL state (?thread=) so reloads
    and direct links render identically in both runtimes. %>
<div class="slack <%= "thread-open" if @thread_parent %>"
     data-instant-refresh
     data-controller="conversation"
     data-action="instant-record:records-changed@window->conversation#sync click->conversation#navigate popstate@window->conversation#popstate">
  <%= render "sidebar" %>

  <%= render "pane" %>

  <% if @thread_parent %>
    <%= render "thread_panel" %>
  <% end %>
</div>
