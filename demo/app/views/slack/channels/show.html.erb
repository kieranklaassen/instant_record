<% content_for(:title, "Swiss Slack — InstantRecord") %>

<div class="slack">
  <%= render "sidebar" %>

  <main class="conversation">
    <header class="conversation-header">
      <h2>
        <% if @channel.dm? %>
          <span class="micro-label">DM</span> <%= @channel.dm_user&.name || @channel.name %>
        <% else %>
          <span class="hash">#</span><%= @channel.name %>
        <% end %>
      </h2>
      <p class="meta">
        Runtime: <strong><%= InstantRecord.browser? ? "browser" : "server" %></strong>
        <% if InstantRecord.browser? %>
          · Pending: <strong><%= @pending_count %></strong>
        <% end %>
      </p>
    </header>

    <ol class="messages">
      <% @messages.each do |message| %>
        <li class="<%= "own" if message.from_visitor? %>">
          <div class="message-head">
            <span class="author"><%= message.chat_user&.name || "Unknown" %></span>
            <span class="timestamp"><%= message.created_at.strftime("%H:%M") %></span>
            <% if message.from_visitor? %>
              <span class="badge badge-<%= message.sync_state %>"><%= message.sync_state %></span>
            <% end %>
          </div>
          <p class="body"><%= message.body %></p>
        </li>
      <% end %>
    </ol>

    <%= form_with url: slack_messages_path, method: :post, class: "composer", data: { turbo: false } do |f| %>
      <%= f.hidden_field "message[channel_id]", value: @channel.id %>
      <%= f.text_field "message[body]", placeholder: @channel.dm? ? "Message #{@channel.dm_user&.name}" : "Message ##{@channel.name}", required: true, autofocus: true, autocomplete: "off" %>
      <%= f.submit "Send" %>
    <% end %>
  </main>
</div>
