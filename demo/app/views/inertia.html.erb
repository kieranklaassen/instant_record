<%# The root of an Inertia page as Rails serves it: the Inbox, or the Inertia
    todo app at /inertia. `npm run build` writes both bundles to
    app/assets/builds. The tag is here and not in the layout, which the
    compiled build rewrites and where it has no controller to ask. The
    compiled runtime renders email/mailboxes/index.html.erb instead and never
    sees this file. %>
<%= inertia_root(page: page) %>
<script type="module" src="<%= asset_path(page[:component].start_with?("Todos/") ? "todos.js" : "inbox.js") %>"></script>
