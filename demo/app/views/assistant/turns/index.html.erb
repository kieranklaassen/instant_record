<% content_for(:title, "Assistant · InstantRecord") %>
<%# Everything on this page is a record: the list of chats, the open chat, each
    question and its answer. A write goes to the controller and comes back as the
    three live parts below, and a records-changed signal asks for them again, so
    the page holds no state of its own. The script only asks the browser's model. %>
<main class="relay" data-controller="assistant-chat" data-instant-refresh
      data-action="instant-record:records-changed@window->assistant-chat#sync instant-record:connection-changed@window->assistant-chat#connection online@window->assistant-chat#connection offline@window->assistant-chat#connection popstate@window->assistant-chat#sync click->assistant-chat#navigate pagehide@window->assistant-chat#stop turbo:before-cache@document->assistant-chat#stop">
  <aside class="relay-sidebar" aria-label="Chat history">
    <div class="relay-wordmark"><span class="relay-sign" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg></span>Assistant</div>
    <button class="relay-new" data-action="assistant-chat#newChat"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>New chat</button>
    <div class="relay-history-scroll">
      <p class="relay-caption">Shared with every visitor</p>
      <%= render "chats" %>
    </div>
  </aside>
  <section class="relay-main">
    <header class="relay-bar">
      <button class="relay-menu" aria-label="Toggle chat history" aria-expanded="false" data-action="assistant-chat#toggleHistory"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      <%= render "title" %>
      <span class="relay-device"><%= InstantRecord.browser? ? "Rendered from local SQLite" : "Rendered by Rails" %></span>
    </header>
    <div class="relay-scroll" tabindex="0" role="region" aria-label="Conversation messages" data-action="scroll->assistant-chat#scrolled" data-assistant-chat-target="scroll">
      <%= render "turns" %>
    </div>
    <div class="relay-foot">
      <button type="button" class="relay-latest" data-assistant-chat-target="latest" data-action="assistant-chat#jumpToLatest" hidden>↓ Latest</button>
      <form class="relay-composer" action="<%= assistant_turns_path %>" method="post" data-turbo="false" data-action="submit->assistant-chat#send">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="turn[assistant_chat_id]" value="<%= @chat_id %>" data-assistant-chat-target="chat">
        <textarea name="turn[prompt]" data-assistant-chat-target="input" aria-label="Message" rows="2" maxlength="8000" placeholder="Ask a question or paste some code…" data-action="keydown->assistant-chat#key"></textarea>
        <div class="relay-controls">
          <fieldset class="relay-engine" data-action="click->assistant-chat#chooseEngine">
            <legend class="visually-hidden">Answer from</legend>
            <label><input type="radio" name="turn[engine]" value="auto" data-assistant-chat-target="engine" checked>Auto</label>
            <label><input type="radio" name="turn[engine]" value="server" data-assistant-chat-target="engine">Server</label>
            <label><input type="radio" name="turn[engine]" value="local" data-assistant-chat-target="engine" disabled>On-device</label>
          </fieldset>
          <button class="relay-send" data-assistant-chat-target="send" aria-label="Send message"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
          <button class="relay-stop" type="button" data-assistant-chat-target="stop" data-action="assistant-chat#stop" hidden>Stop</button>
        </div>
      </form>
      <p class="relay-status" role="status" data-assistant-chat-target="status"></p>
    </div>
  </section>
</main>
