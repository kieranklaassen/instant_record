<% content_for(:title, "Relay · Assistant chat") %>
<main class="relay" data-controller="assistant-chat" data-instant-refresh
      data-action="instant-record:connection-changed@window->assistant-chat#connection online@window->assistant-chat#connection offline@window->assistant-chat#connection storage@window->assistant-chat#storage pagehide@window->assistant-chat#stop turbo:before-cache@document->assistant-chat#stop">
  <aside class="relay-sidebar" aria-label="Chat history">
    <div class="relay-wordmark"><span class="relay-sign" aria-hidden="true">✳</span>Relay</div>
    <button class="relay-new" data-action="assistant-chat#newChat"><span aria-hidden="true">＋</span> New chat</button>
    <div class="relay-history-scroll">
      <p class="relay-caption">Conversations</p>
      <nav data-assistant-chat-target="history" aria-label="Conversations"></nav>
    </div>
    <a class="relay-back" href="/" data-turbo="false">← All demos</a>
  </aside>
  <section class="relay-main">
    <header class="relay-bar">
      <button class="relay-menu" aria-label="Toggle chat history" aria-expanded="false" data-action="assistant-chat#toggleHistory">☰</button>
      <strong data-assistant-chat-target="title">New chat</strong>
      <span class="relay-device">Saved on this device</span>
      <a class="relay-source" href="#source-drawer" data-turbo="false" data-open-source>View source</a>
    </header>
    <div class="relay-scroll" tabindex="0" role="region" aria-label="Conversation messages" data-action="scroll->assistant-chat#scrolled" data-assistant-chat-target="scroll">
      <div class="relay-welcome" data-assistant-chat-target="welcome">
        <span class="relay-sign relay-hero" aria-hidden="true">✳</span>
        <h1>What are we building?</h1>
        <div class="relay-starters" data-action="click->assistant-chat#suggest">
          <button type="button"><span aria-hidden="true">▤</span> Inspect my workspace</button>
          <button type="button"><span aria-hidden="true">⇄</span> Explain offline sync</button>
          <button type="button"><span aria-hidden="true">{ }</span> Show a Rails query</button>
        </div>
      </div>
      <button type="button" class="relay-older" data-assistant-chat-target="older" data-action="assistant-chat#loadOlder" hidden>Load earlier messages</button>
      <div class="relay-transcript" data-assistant-chat-target="transcript" aria-label="Messages"></div>
    </div>
    <div class="relay-foot">
      <button type="button" class="relay-latest" data-assistant-chat-target="latest" data-action="assistant-chat#jumpToLatest" hidden>↓ Latest</button>
      <form class="relay-composer" data-action="submit->assistant-chat#send">
        <textarea data-assistant-chat-target="input" aria-label="Message" rows="2" maxlength="8000" placeholder="Ask a question or paste some code…" data-action="keydown->assistant-chat#key input->assistant-chat#saveDraft"></textarea>
        <div class="relay-controls">
          <span class="relay-engine"><span class="relay-dot" aria-hidden="true"></span> Rails demo guide</span>
          <button class="relay-send" data-assistant-chat-target="send" aria-label="Send message">↑</button>
          <button class="relay-stop" type="button" data-assistant-chat-target="stop" data-action="assistant-chat#stop" hidden>Stop</button>
        </div>
      </form>
      <p class="relay-status" role="status" data-assistant-chat-target="status"></p>
    </div>
  </section>
</main>
