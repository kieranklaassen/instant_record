# Copy to config/instant_record_toolchain.env (or compiled/toolchain.env in this repo)
# and fill in absolute paths. A value may refer to an earlier one as $NAME.
TOOLS=/path/to/a/working/folder
# Spinel checkout, built with `make` and `make wasm-rt` (bin/spinel and bin/spin inside it)
SPINEL_HOME=$TOOLS/spinel
# Roundhouse binary built from its main branch (`cargo build --release`)
ROUNDHOUSE_BIN=$TOOLS/roundhouse/target/release/roundhouse
# Unpacked wasi-sdk (34 or later)
WASI_SDK=$TOOLS/wasi-sdk
# Unpacked SQLite amalgamation (the folder holding sqlite3.c and sqlite3.h)
SQLITE_SRC=$TOOLS/sqlite-amalgamation
# node_modules holding the packages from the gem's compiled/web/package.json
WEB_NODE_MODULES=$TOOLS/web-node_modules
# Scratch space for cached build products (e.g. compiled libsqlite3.a)
CACHE=$TOOLS/cache

# Optional for consumer apps using Bundler: turbo-rails and stimulus-rails assets
# are resolved from Gem.loaded_specs automatically when RAILS_GEMS is omitted.
# RAILS_GEMS=$TOOLS/gems

# Optional (InstantRecord repo benchmarks and browser tests only):
# PLAYWRIGHT_NODE_MODULES=$TOOLS/playwright-node_modules
