# Copy to .kamal/deploy.env (not committed), fill in, then: source .kamal/deploy.env
export KAMAL_SERVICE=instant-record-compiled
export KAMAL_IMAGE=your-github-user/instant-record-compiled
export KAMAL_WEB_HOST=your-server
export KAMAL_SSH_USER=your-ssh-user
# One or more hostnames, comma separated. Each needs DNS pointing at the server.
export KAMAL_PROXY_HOSTS=compiled.example.com
export KAMAL_REGISTRY_SERVER=ghcr.io
export KAMAL_REGISTRY_USERNAME=your-github-user
export KAMAL_BUILDER_ARCH=amd64
# Optional: build on the server instead of locally.
export KAMAL_BUILDER_REMOTE=
